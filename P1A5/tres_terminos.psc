//Realizar un algoritmo en pseudocódigo que lea tres números. Calcule e imprima la suma, el producto y el promedio de estos.
Algoritmo tres_terminos
	Definir num1, num2, num3 Como Entero
	Escribir "el primer numero:"
	Leer num1
	Escribir "el segundo numero:"
	Leer num2
	Escribir "el tercer numero:"
	Leer num3 
	//calcular suma 
	suma<-num1+num2 +num3
	//producto 
	producto<- num1*num2*num3
	//calcular promedio 
	promedio <- suma / 3
	
	
	Escribir "promedio:" promedio
	
	
FinAlgoritmo
