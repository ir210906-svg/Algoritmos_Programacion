Algoritmo Ganancia
	Definir capital_inicial, tasa_interes, ganancia_mensual, capital_final Como Real
	ESCRIBIR "capital a invertir:"
	LEER capital_inicial
	//interes mensual 
	tasa_interes <- 0.02
	//calcular ganancia 
	ganancia_mensual <- capital_inicial * tasa_interes
	//capital despues del mes 
	capital_final <- capital_inicial + ganancia_mensual
	ESCRIBIR "Capital total después de 1 mes: $", capital_final
	
	
	
	
	
	

	
FinAlgoritmo
